# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/referral"

# JWT signing secret (use a long random string in production)
JWT_SECRET="change-this-to-a-strong-secret"

# Server port
PORT=5000

